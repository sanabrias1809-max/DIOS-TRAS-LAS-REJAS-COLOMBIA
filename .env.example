# Copia este archivo como .env (local) o configura estas variables en tu hosting.
# Ninguna es secreta: todas terminan visibles en el sitio público.

# Dominio definitivo, sin "/" al final (canonical, Open Graph, sitemap)
SITE_URL=https://www.tudominio.org

# WhatsApp en formato internacional sin "+"
WHATSAPP_NUMBER=573002079151
CONTACT_EMAIL=

# Redes (vacío = no se muestra)
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=

# Formularios: endpoint POST JSON (ej. https://formspree.io/f/XXXXXXX).
# Vacío = los formularios abren WhatsApp con el mensaje listo.
FORM_ENDPOINT=

# Donaciones: enlaces de pago de Wompi / PayU / Mercado Pago / Stripe.
# Vacío = la donación se coordina por WhatsApp con el monto elegido.
DONATION_PROVIDER_NAME=
DONATION_ONCE_URL=
DONATION_MONTHLY_URL=

# Transferencia bancaria (solo datos oficiales de la fundación)
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
ORG_NIT=
